	}
	
	//It is used to add new policy for the employees
	public static void addNewPolicy(String leaveType, int annualEntitlement, String accuralRule, int carryForward, boolean encashment, boolean probationAccural) {
		
		try {
			String sql = "insert into leave_policy (leave_type, 			annual_entitlement,accrual_rule,carry_forward_limit,encashment_allowed,probation_accrual) values (?,?,?,?,?,?)";
			
			String sql1 = "Select emp_id from employee e"
					+ " join user u on e.user_id = u.user_id"
					+ " join role r on r.role_id = u.role_id"
					+ " where r.role_name = 'EMPLOYEE' ";
			
			String sql2 = "insert into leave_balance (employee_id, policy_id, leave_balance) values (?,?,?)";
			
			String sql3 = "select policy_id from leave_policy where leave_type = ?";
			
			con = DBUtil.getConnection();
			PreparedStatement ps = con.prepareStatement(sql);
			ps.setString(1,leaveType);
			ps.setInt(2, annualEntitlement);
			ps.setString(3, accuralRule);
			ps.setInt(4,carryForward);
			ps.setBoolean(5, encashment);
			ps.setBoolean(6, probationAccural);
			ps.executeUpdate();
			
			Statement st = con.createStatement();
			ResultSet rs = st.executeQuery(sql1);
			
			PreparedStatement ps1 = con.prepareStatement(sql3);
			ps1.setString(1, leaveType);
			ResultSet rs1 = ps1.executeQuery();
			
			int id = 0;
			if(rs1.next())
				id = rs1.getInt(1);
			
			while(rs.next()) {
				ps = con.prepareStatement(sql2);
				ps.setInt(1, rs.getInt(1));
				ps.setInt(2,id);
				ps.setInt(3,annualEntitlement);
				ps.executeUpdate();
			}
			
			System.out.println("inserted successfully");
			
		}
		catch(Exception e) {
			System.out.println(e.toString()+"check weather there is a problem in sql connection or query");
			e.printStackTrace();
			
		}
		
		
	}
	

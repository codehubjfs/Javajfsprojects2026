	//It is used to view all the employees
	public static void allEmployees() throws Exception {
		
		String sql = "select e.emp_id,concat(e.first_name,e.last_name) as name,e.join_date,e.employee_type,e.skill_set,p.project_name,ep.assigned_date from employee e"
				+ " join employee_project ep on e.emp_id = ep.emp_id"
				+ " join project p on ep.project_id = p.project_id;";
		
		
		con = DBUtil.getConnection();
		Statement st = con.createStatement();
		ResultSet rs = st.executeQuery(sql);
		
		while(rs.next()) {
			System.out.println(rs.getInt(1)+"\t"+rs.getString(2)+"\t"+rs.getDate(3)+"\t"+rs.getString(4)+"\t"+rs.getString(5)+"\t"+rs.getString(6)+"\t\t\t"+rs.getDate(7));

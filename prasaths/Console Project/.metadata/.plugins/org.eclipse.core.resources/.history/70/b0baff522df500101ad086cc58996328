package servicelayer;
import java.util.*;

import DAO.AdminDao;

public class Admin {
	
	private static final Scanner sc = new Scanner(System.in);
	
	public static void accessControls() throws Exception {
		
		boolean terminate = false;
		
		do {
			System.out.println("Enter 1 to view all employees");
			System.out.println("Enter 2 add new employee");
			System.out.println("Enter 3 to add the leave policy");
			System.out.println("Enter 4 to update the leave policy");
			System.out.println("Enter 5 to exit");
			System.out.println("Enter the choice:");
			int choice = sc.nextInt();
			
			switch(choice) {
				case 1:
					viewAll();
					break;
				case 5:
					terminate = true;
					System.out.println("Return to the login page");
					break;
				default:
					System.out.println("Enter the correct choice");
			}
			
		}
		while(!terminate);
		
	}
	
	public static void viewAll() throws Exception {
		System.out.println("================================================");
		System.out.println("All employee data");
		AdminDao.allEmployees();
		System.out.println("================================================");
	}
	

package model;
import java.time.LocalDate;

public class Employee extends Person{
	
	int employeeId;
	String firstName;
	String lastName;
	SkillSet skill;
	LocalDate joinDate;
	EmployeeType empType;
	
	public Employee(String email, String contact, LocalDate dob, Gender gender, String state, String city,
			String street, String pincode, int employeeId, String firstName, String lastName, SkillSet skill,
			LocalDate joinDate, EmployeeType empType) {
		super(email, contact, dob, gender, state, city, street, pincode);
		this.employeeId = employeeId;
		this.firstName = firstName;
		this.lastName = lastName;
		this.skill = skill;
		this.joinDate = joinDate;
		this.empType = empType;
	}

	public int getEmployeeId() {
		return employeeId;
	}

	public void setEmployeeId(int employeeId) {
		this.employeeId = employeeId;
	}

	public String getFirstName() {
		return firstName;
	}

	public void setFirstName(String firstName) {
		this.firstName = firstName;
	}

	public String getLastName() {
		return lastName;
	}

	public void setLastName(String lastName) {
		this.lastName = lastName;
	}

	public SkillSet getSkill() {
		return skill;
	}

	public void setSkill(SkillSet skill) {
		this.skill = skill;
	}

	public LocalDate getJoinDate() {
		return joinDate;
	}

	public void setJoinDate(LocalDate joinDate) {
		this.joinDate = joinDate;
	}

	public EmployeeType getEmpType() {
		return empType;
	}

	public void setEmpType(EmployeeType empType) {
		this.empType = empType;
	}

	@Override
	public String toString() {
		return "Employee [employeeId=" + employeeId + ", firstName=" + firstName + ", lastName=" + lastName + ", skill="
				+ skill + ", joinDate=" + joinDate + ", empType=" + empType + ", email=" + email + ", contact="
				+ contact + ", dob=" + dob + ", gender=" + gender + ", state=" + state + ", city=" + city + ", street="
				+ street + ", pincode=" + pincode + "]";
	}


}

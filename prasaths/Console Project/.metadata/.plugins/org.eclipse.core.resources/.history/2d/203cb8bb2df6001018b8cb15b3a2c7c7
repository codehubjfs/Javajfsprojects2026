package DAO;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import Exceptions.InCorrectPasswordException;
import Exceptions.InvalidRole;
import Exceptions.UserNotFoundException;

public class LoginCheck {
	
	static Connection con = null;
	
	public static void viewRoles() throws Exception {
		
		con = DBUtil.getConnection();
		String sql1 = "select * from role";
		Statement st = con.createStatement();
		ResultSet rs1 = st.executeQuery(sql1);
		
		while(rs1.next()) {
			System.out.println("Enter "+rs1.getInt(1)+" for "+rs1.getString(2));
		}
		
	}
	
	public static boolean isValidUser(String email, String password) throws UserNotFoundException, InCorrectPasswordException, InvalidRole, SQLException {
		
		System.out.println(email+" "+password);
		String sql2 = " select e.email,u.password from employee e "
				+" join user u on e.user_id = u.user_id"
				+" where e.email = ? and u.password = ?";
		
		PreparedStatement st2 = con.prepareStatement(sql2);
		st2.setString(1,email);
		st2.setString(2, password);
		ResultSet rs = st2.executeQuery();
		
		if (! rs.next()) {
			throw new UserNotFoundException();
		}

		if(! password.equals(rs.getString(2))) {
			throw new InCorrectPasswordException();
		}
		
		return true;
		
	}

	public static String getRole(String email, String pass) throws Exception {
		
		String sql = "select r.role_name from employee e "
				+" join user u on e.user_id = u.user_id"
				+" join role r on u.role_id = r.role_id"
				+" where e.email = ? and u.password = ?";
		
		con = DBUtil.getConnection();
		Statement st = con.createStatement();
		ResultSet rs = st.executeQuery(sql);
		
		return rs.getString(1);
		
	}
	
}

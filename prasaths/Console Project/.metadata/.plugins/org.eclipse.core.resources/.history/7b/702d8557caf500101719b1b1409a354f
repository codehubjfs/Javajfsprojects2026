	//addLeavePolicy function which is used to add new policy for the employees
	public static void addLeavePolicy() throws Exception{
		
		System.out.println("============================================================");
		System.out.println("Add new leave policy\n");
		try {
			System.out.println("--------------------------------");
			System.out.println("|Enter the leave policy Name:  |");
			System.out.println("--------------------------------");
			sc.nextLine();
			String leaveType = sc.nextLine();
			if(!(leaveType.matches("^[a-zA-Z]$"))) {
				throw new LeaveTypeException("The value enter is not in the string");
			}
			
			System.out.println("--------------------------------------------------------------------");
			System.out.println("|Enter the annual entitlement in postive values from 1 to 18 days: |");
			System.out.println("--------------------------------------------------------------------");
			int annualEntitle = sc.nextInt();
			if(annualEntitle < 0 || annualEntitle > 18) {
				throw new AnnualEntitleException("Invalid number of days has been entered");
			}
			if(!(Integer.toString(annualEntitle).matches("^[0-9]$"))) {
				throw new AnnualEntitleException("Invalid number of days has been entered");
			}
			
			System.out.println("---------------------------------------------------------------");
			System.out.println("|Enter the accural rule is applicable for monthly or weekly:  |");
			System.out.println("|For montly please enter 1 or for weekly please enter 2		  |");
			System.out.println("---------------------------------------------------------------");
			int accuralRule = sc.nextInt();
			if(accuralRule != 1 && accuralRule != 0) {
				throw new IllegalArgumentException("Invalid input has been entered in the accural rule");
			}
			String ac = "";
			if(accuralRule == 1) {
				ac = "MONTHLY";
			}
			else {
				ac = "YEARLY";
			}
			
			System.out.println("---------------------------------");
			System.out.println("|Enter the carry_forward_limit from 1 to 5 days: |");
			System.out.println("---------------------------------");
			int carryForward = sc.nextInt();
			if(carryForward < 0 || carryForward > 5) {
				throw new IllegalArgumentException("Invalid input has been entered in the accural rule");
			}
			
			System.out.println("----------------------------------------------------------------");
			System.out.println("|If encashment allowed means please enter 1 or please enter 0: |");
			System.out.println("----------------------------------------------------------------");
			int allowed = sc.nextInt();
			if(accuralRule != 1 && accuralRule != 0) {
				throw new IllegalArgumentException("Invalid input has been entered in the encashment allowed");
			}
			boolean allow = false;
			if(allowed == 1) {
				allow = true;
			}
			
			System.out.println("--------------------------------------------------------------------------------------");
			System.out.println("|If acuural rule is applicable for probation means please enter 1 or please enter 0: |");
			System.out.println("--------------------------------------------------------------------------------------");
			int probationAllowed = sc.nextInt();
			if(accuralRule != 1 && accuralRule != 0) {
				throw new IllegalArgumentException("Invalid input has been entered in the probation allowed");
			}
			boolean probation = false;
			if(probationAllowed == 1) {
				probation = true;
			}
			
			System.out.println(leaveType.toUpperCase()+" "+annualEntitle+" "+ac+" "+carryForward+" "+allow+" "+probation);
			//AdminDao.addNewPolicy(leaveType.toUpperCase(),annualEntitle,ac,carryForward,allow,probation);
			System.out.println("New policy has been added successfully!!");
		}
		catch(InputMismatchException e) {
			System.out.println(e.toString());
			sc.nextLine();
		}
		catch(Exception e) {
			System.out.println(e.toString());
		}
		
	}

